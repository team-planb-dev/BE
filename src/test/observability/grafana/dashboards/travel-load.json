        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hikaricp_connections_usage_seconds_sum[10s])) / sum(rate(hikaricp_connections_usage_seconds_count[10s]))",
          "legendFormat": "평균",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(hikaricp_connections_usage_seconds_max)",
          "legendFormat": "최대",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "커넥션을 빌려 반납하기까지의 시간. 트랜잭션이 AI 호출을 감싸면 이 값이 길어진다."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "JVM 스레드·메모리",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
